DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/content-hub?authSource=admin

# content-hub-web is a public client (no secret) — JWTs are validated via
# Keycloak's JWKS endpoint instead, see src/config/keycloak.config.ts
KEYCLOAK_URL=https://your-keycloak-domain
KEYCLOAK_REALM=content-hub
KEYCLOAK_CLIENT_ID=content-hub-web

JWT_SECRET=generate-strong-secret-key
PORT=3001
NODE_ENV=production
